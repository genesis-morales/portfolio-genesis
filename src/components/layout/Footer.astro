---
import { GitHubIcon, LinkedInIcon } from "../iconos/SocialIcons.astro"

const links = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/génesismoralescastro/",
    icon: LinkedInIcon,
  },
  {
    label: "GitHub",
    href: "https://github.com/genesis-morales",
    icon: GitHubIcon,
  },
]
---
<footer class="bg-slate-950 w-full py-12 border-t border-white/5">
  <div class="flex flex-col md:flex-row justify-between items-center px-8 max-w-7xl mx-auto gap-4">

    <span class="text-lg font-black text-slate-200 font-headline">
      Génesis Morales
    </span>

    <span class="text-slate-500 text-sm uppercase tracking-wide">
      © 2026 Génesis Morales
    </span>

    <div class="flex gap-3">
      {links.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 rounded-xl bg-surface-container-high border border-outline-variant/20 text-on-surface hover:border-primary/40 hover:text-primary transition-all text-sm font-semibold"
        >
          <Fragment set:html={l.icon} />
          {l.label}
        </a>
      ))}
    </div>

  </div>
</footer>