---
const links = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/g%C3%A9nesismoralescastro/" },
  { label: "GitHub",   href: "https://github.com/genesis-morales" },
]
---
<footer class="bg-slate-950 w-full py-12 border-t border-white/5">
  <div class="flex flex-col md:flex-row justify-between items-center px-8 max-w-7xl mx-auto gap-4">
    <span class="text-lg font-black text-slate-200 font-headline">Génesis Morales</span>
    <span class="text-slate-500 text-sm uppercase tracking-wide">
      © 2026 Génesis Morales
    </span>
    <div class="flex gap-6">
      {links.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-500 hover:text-violet-200 transition-colors text-sm uppercase tracking-widest font-semibold"
        >
          {l.label}
        </a>
      ))}
    </div>
  </div>
</footer>