---
const services = [
  {
    icon: "code",
    title: "Desarrollo web",
    description: "Aplicaciones y sitios web a medida, construidos con tecnologías modernas y optimizados para rendimiento y SEO.",
  },
  {
    icon: "web_asset",
    title: "Landing pages",
    description: "Páginas de aterrizaje rápidas, visualmente atractivas y diseñadas para convertir visitantes en clientes.",
  },
  {
    icon: "settings_suggest",
    title: "Sistemas personalizados",
    description: "Desde APIs REST hasta paneles administrativos — soluciones técnicas adaptadas a las necesidades reales de tu negocio.",
  },
  {
    icon: "build",
    title: "Mantenimiento",
    description: "Soporte y mejoras continuas para sitios y aplicaciones existentes.",
  },
]
---
<section class="py-32 px-6 bg-surface" id="servicios">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-20">
      <h2 class="font-headline text-4xl md:text-5xl font-bold text-on-surface mb-4">Servicios</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-primary to-transparent mx-auto"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((s) => (
        <div class="glass-panel p-8 rounded-2xl hover:bg-surface-container-high transition-all group">
          <span class="material-symbols-outlined text-primary text-4xl mb-6 group-hover:scale-110 transition-transform block">
            {s.icon}
          </span>
          <h3 class="text-xl font-bold text-on-surface mb-4">{s.title}</h3>
          <p class="text-on-surface-variant text-sm leading-relaxed">{s.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>