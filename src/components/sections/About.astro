---
// src/components/sections/About.astro

const stack = {
  "Full Stack": ["React", "Astro", "TypeScript", "Spring Boot", ".NET", "Laravel", "WordPress"],
  "Lenguajes": ["Java", "JavaScript", "TypeScript", "PHP", "C#"],
  "Bases de datos": ["PostgreSQL", "MySQL", "MongoDB", "SQL Server"],
  "DevOps & CI/CD": ["CI/CD", "GitHub Actions", "Pipelines"],
  "Herramientas": ["VS Code", "IntelliJ IDEA", "Figma", "Git", "GitHub", "Postman", "Swagger", "JIRA"],
  "QA & Automatización": ["Cypress", "Zapier", "Make"],
}
---

<section class="py-24 bg-surface-container-low px-6" id="sobre-mi">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">

    <div class="relative group">
      <div class="absolute -inset-4 bg-gradient-to-tr from-primary/20 to-transparent rounded-[2.5rem] blur-xl opacity-50 group-hover:opacity-100 transition-opacity"></div>
      <div class="relative rounded-2xl overflow-hidden aspect-[15/] border border-outline-variant/10">
        <img
          src="/foto.jpeg"
          alt="Génesis Morales"
          class="w-full h-full object-cover"
          width="500"
          height="500"
          loading="lazy"
        />
      </div>
    </div>

    <div>
      <span class="text-primary font-label text-sm uppercase tracking-[0.2em] font-bold mb-4 block">
        Génesis Morales
      </span>

      <h2 class="font-headline text-3xl md:text-5xl font-bold text-on-surface mb-8 leading-snug">
        Desarrollo software que funciona, se ve bien y es fácil de mantener.
      </h2>

      <p class="font-body text-on-surface-variant text-lg leading-relaxed mb-8">
        Me especializo en desarrollo full stack usando React con TypeScript,
        Java Spring Boot, Laravel y Astro. Priorizo el rendimiento, el código
        limpio y una experiencia de usuario que realmente funcione. Estoy
        disponible para proyectos freelance y colaboraciones.
      </p>

<div class="space-y-4 mt-8">
  {Object.entries(stack).map(([category, items]) => (
    <div>
      <p class="text-on-surface-variant text-xs uppercase tracking-widest font-semibold mb-2">
        {category}
      </p>
      <div class="flex flex-wrap gap-2">
        {items.map((tech) => (
          <span class="px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container text-xs font-semibold">
            {tech}
          </span>
        ))}
      </div>
    </div>
    ))}
</div>
  </div>
</section>