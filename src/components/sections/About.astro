---
// src/components/sections/About.astro

const techs = [
  "React", "TypeScript", "Spring Boot",
  "Laravel", "Astro", "PostgreSQL", "MySQL"
]
---

<section class="py-24 bg-surface-container-low px-6" id="sobre-mi">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">

    <!-- Foto -->
    <div class="relative group">
      <div class="absolute -inset-4 bg-gradient-to-tr from-primary/20 to-transparent rounded-[2.5rem] blur-xl opacity-50 group-hover:opacity-100 transition-opacity"></div>
      <div class="relative rounded-2xl overflow-hidden aspect-[4/5] border border-outline-variant/10">
        <!-- Reemplaza con tu foto real en public/foto.jpg -->
        <img
          src="/foto.jpeg"
          alt="Génesis Morales"
          class="w-full h-full object-cover"
          width="600"
          height="750"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Texto -->
    <div>
      <span class="text-primary font-label text-sm uppercase tracking-[0.2em] font-bold mb-4 block">
        Génesis Morales
      </span>

      <h2 class="font-headline text-3xl md:text-5xl font-bold text-on-surface mb-8 leading-snug">
        Desarrollo software que funciona, se ve bien y es fácil de mantener.
      </h2>

      <p class="font-body text-on-surface-variant text-lg leading-relaxed mb-8">
        Me especializo en desarrollo full stack usando React con TypeScript,
        Java Spring Boot, Laravel y Astro. Priorizo el rendimiento, el código
        limpio y una experiencia de usuario que realmente funcione. Estoy
        disponible para proyectos freelance y colaboraciones.
      </p>

      <!-- Chips de tecnologías -->
      <div class="flex flex-wrap gap-2">
        {techs.map((tech) => (
          <span class="px-4 py-1.5 rounded-full bg-secondary-container text-on-secondary-container text-xs font-semibold">
            {tech}
          </span>
        ))}
      </div>
    </div>

  </div>
</section>