---
const stack = [
  { name: "React",       icon: "react",       color: "61DAFB" },
  { name: "TypeScript",  icon: "typescript",  color: "3178C6" },
  { name: "Astro",       icon: "astro",       color: "FF5D01" },
  { name: "Laravel",     icon: "laravel",     color: "FF2D20" },
  { name: "Spring Boot", icon: "springboot",  color: "6DB33F" },
  { name: "Java",        icon: "openjdk",     color: "ED8B00" },
  { name: "PHP",         icon: "php",         color: "9B7FC0" },
  { name: "MySQL",       icon: "mysql",       color: "4479A1" },
  { name: "PostgreSQL",  icon: "postgresql",  color: "4169E1" },
  { name: "Tailwind",    icon: "tailwindcss", color: "06B6D4" },
  { name: "Git",         icon: "git",         color: "F05032" },
  { name: "GitHub",      icon: "github",      color: "ffffff" },
];
---

<section class="py-24 bg-surface-container-low px-6" id="sobre-mi">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">

    <div class="relative group">
      <div class="absolute -inset-4 bg-gradient-to-tr from-primary/20 to-transparent rounded-[2.5rem] blur-xl opacity-50 transition-opacity group-hover:opacity-100"></div>
      <div class="relative overflow-hidden rounded-2xl border border-outline-variant/10 aspect-square">
        <img
          src="/foto.jpeg"
          alt="Génesis Morales"
          class="w-full h-full object-cover"
          width="500"
          height="500"
          loading="lazy"
        />
      </div>
    </div>

    <div>
      <span class="mb-4 block text-sm font-bold uppercase tracking-[0.2em] text-primary">
        Génesis Morales
      </span>

      <h2 class="font-headline mb-8 text-3xl font-bold leading-snug text-on-surface md:text-5xl">
        Desarrollo software que funciona, se ve bien y es fácil de mantener.
      </h2>

      <p class="mb-10 text-lg leading-relaxed text-on-surface-variant">
        Me especializo en desarrollo full stack. Priorizo el rendimiento, el código
        limpio y una experiencia de usuario que realmente funcione. Estoy
        disponible para proyectos freelance y colaboraciones.
      </p>

      <div>
        <p class="mb-5 text-xs font-semibold uppercase tracking-[0.18em] text-on-surface-variant/60">
          Stack
        </p>
        <div class="flex flex-wrap gap-4">
          {stack.map((tech) => (
            <div class="group/icon flex flex-col items-center gap-2">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-outline-variant/15 bg-surface p-2.5 transition duration-200 group-hover/icon:border-outline-variant/40 group-hover/icon:shadow-md">
                <img
                  src={`https://cdn.simpleicons.org/${tech.icon}/${tech.color}`}                  
                  alt={tech.name}
                  width="28"
                  height="28"
                  class="h-7 w-7 object-contain"
                  loading="lazy"
                />
              </div>
              <span class="text-[11px] text-on-surface-variant/60 transition group-hover/icon:text-on-surface">
                {tech.name}
              </span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>