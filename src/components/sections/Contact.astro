---
const FORMSPREE_URL = "https://formspree.io/f/mkopalea"
---

<section class="py-32 px-6 bg-surface relative" id="contacto">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(111,61,217,0.05)_0%,_transparent_70%)] pointer-events-none"></div>

<div class="max-w-2xl mx-auto glass-panel p-6 sm:p-10 md:p-12 rounded-2xl md:rounded-[3rem]">
    <!-- Header -->
    <div class="text-center mb-12">
      <h2 class="font-headline text-4xl md:text-5xl font-extrabold text-on-surface mb-4">
        ¿Tienes un proyecto en mente?
      </h2>
      <p class="text-on-surface-variant text-lg">
        Estoy disponible para freelance, colaboraciones y empleo. Hablemos.
      </p>
    </div>

    <!-- Formulario -->
    <form
      id="contact-form"
      action={FORMSPREE_URL}
      method="POST"
      class="space-y-6"
    >
      <!-- Honeypot para bots -->
    <input
      type="text"
      name="_honeypot"
      autocomplete="off"
      tabindex="-1"
      aria-hidden="true"
      class="absolute -left-[9999px] opacity-0 pointer-events-none"
  />
      <!-- Nombre + Email -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="flex flex-col gap-2">
          <label for="name" class="text-on-surface-variant text-sm font-semibold uppercase tracking-widest">
            Nombre
          </label>
          <input
            id="name"
            type="text"
            name="name"
            required
            placeholder="Tu nombre"
            class="bg-surface-container border border-outline-variant/30 text-on-surface rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-primary/60 focus:ring-1 focus:ring-primary/30 transition-all placeholder:text-on-surface-variant/40"
          />
        </div>
        <div class="flex flex-col gap-2">
          <label for="email" class="text-on-surface-variant text-sm font-semibold uppercase tracking-widest">
            Correo
          </label>
          <input
            id="email"
            type="email"
            name="email"
            required
            placeholder="tucorreo@dominio.com"
            class="bg-surface-container border border-outline-variant/30 text-on-surface rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-primary/60 focus:ring-1 focus:ring-primary/30 transition-all placeholder:text-on-surface-variant/40"
          />
        </div>
      </div>

        <!-- Teléfono (opcional) -->
        <div class="flex flex-col gap-2">
          <label for="phone" class="text-on-surface-variant text-sm font-semibold uppercase tracking-widest">
            Teléfono
            <span class="text-on-surface-variant/40 normal-case tracking-normal font-normal ml-1">(opcional)</span>
          </label>
          <input
            id="phone"
            type="tel"
            name="phone"
            placeholder="+506 8888 8888"
            class="bg-surface-container border border-outline-variant/30 text-on-surface rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-primary/60 focus:ring-1 focus:ring-primary/30 transition-all placeholder:text-on-surface-variant/40"
          />
        </div>

      <!-- Asunto -->
      <div class="flex flex-col gap-2">
        <label for="subject" class="text-on-surface-variant text-sm font-semibold uppercase tracking-widest">
          Asunto
        </label>
        <input
          id="subject"
          type="text"
          name="subject"
          placeholder="¿En qué puedo ayudarte?"
          class="bg-surface-container border border-outline-variant/30 text-on-surface rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-primary/60 focus:ring-1 focus:ring-primary/30 transition-all placeholder:text-on-surface-variant/40"
        />
      </div>

      <!-- Mensaje -->
      <div class="flex flex-col gap-2">
        <label for="message" class="text-on-surface-variant text-sm font-semibold uppercase tracking-widest">
          Mensaje
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows="5"
          placeholder="Cuéntame sobre tu proyecto..."
          class="bg-surface-container border border-outline-variant/30 text-on-surface rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-primary/60 focus:ring-1 focus:ring-primary/30 transition-all placeholder:text-on-surface-variant/40 resize-none"
        ></textarea>
      </div>

      <!-- Botón -->
      <button
        type="submit"
        id="submit-btn"
        class="btn-primary w-full text-on-primary font-bold py-3 sm:py-4 rounded-full text-base sm:text-lg hover:shadow-[0_0_50px_rgba(111,61,217,0.5)] transition-all flex items-center justify-center gap-3"
        >
        <span id="btn-text">Enviar mensaje</span>
        <span id="btn-icon" class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">send</span>
      </button>

      <!-- Mensaje de éxito -->
      <div id="success-msg" class="hidden text-center py-4 text-green-400 font-semibold">
        ¡Mensaje enviado! Te responderé pronto.
      </div>

      <!-- Mensaje de error -->
      <div id="error-msg" class="hidden text-center py-4 text-red-400 font-semibold">
        Algo salió mal. Intenta de nuevo.
      </div>
    </form>

  </div>
</section>

<script>
  const form       = document.getElementById('contact-form') as HTMLFormElement
  const btnText    = document.getElementById('btn-text') as HTMLSpanElement
  const btnIcon    = document.getElementById('btn-icon') as HTMLSpanElement
  const submitBtn  = document.getElementById('submit-btn') as HTMLButtonElement
  const successMsg = document.getElementById('success-msg') as HTMLDivElement
  const errorMsg   = document.getElementById('error-msg') as HTMLDivElement

  // Clave en sessionStorage para bloquear después del primer envío exitoso
  const SENT_KEY = 'contact_sent'

  // Si ya envió en esta sesión, deshabilitar el botón al cargar
  if (sessionStorage.getItem(SENT_KEY)) {
    submitBtn.disabled = true
    btnText.textContent = 'Mensaje ya enviado'
    btnIcon.style.display = 'none'
    successMsg.classList.remove('hidden')
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault()

    // Verificar honeypot — si tiene valor, es un bot
    const honeypot = form.querySelector<HTMLInputElement>('[name="_honeypot"]')
    if (honeypot?.value) return

    // Bloquear doble clic inmediatamente
    submitBtn.disabled = true
    btnText.textContent = 'Enviando...'
    btnIcon.style.display = 'none'

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' }
      })

      if (response.ok) {
        form.reset()
        successMsg.classList.remove('hidden')
        errorMsg.classList.add('hidden')
        btnText.textContent = 'Mensaje enviado'

        // Guardar en sessionStorage — bloquea reintentos en esta sesión
        sessionStorage.setItem(SENT_KEY, '1')
      } else {
        throw new Error('Error')
      }
    } catch {
      errorMsg.classList.remove('hidden')
      successMsg.classList.add('hidden')
      btnText.textContent = 'Enviar mensaje'
      btnIcon.style.display = 'inline'
      // Re-habilitar solo si falló para que pueda intentar de nuevo
      submitBtn.disabled = false
    }
  })
</script>