---
type ProjectLink = {
  label: string;
  href: string;
  primary?: boolean;
};

type Project = {
  title: string;
  category: string;
  year: string;
  description: string;
  stack: string[];
  images: string[];
  alt: string;
  links: ProjectLink[];
};

const projects: Project[] = [
    {
    title: "Roberto Herrera — Clases de música",
    category: "Sitio web · informativo con agenda de clases",
    year: "2026",
    description:
      "Sitio informativo para músico y docente. Presenta su oferta de clases, perfil artístico y agenda directa mediante Calendly.",
    stack: ["Astro", "Tailwind"],
    images: ["/projects/profesor-musica.png"],
    alt: "Sitio web para profesor de música Roberto Herrera",
    links: [
      {
        label: "Ver sitio",
        href: "https://robhs-web.vercel.app/",
        primary: true,
      },
    ],
  },
  {
    title: "Catálogo de productos",
    category: "Full Stack · E-commerce",
    year: "2026",
    description:
      "Plataforma de compras con catálogo público, carrito y checkout. Panel administrativo para gestionar inventario, órdenes y clientes.",
    stack: ["React", "TypeScript", "SCSS", "Laravel", "MySQL"],
    images: [
      "/projects/store.jpg",
       "/projects/item.jpg",
      "/projects/dashboard.jpg",
      "/projects/products.jpg",
      "/projects/orders.jpg",
      "/projects/clients.jpg",
    ],
    alt: "Capturas del catálogo de productos",
    links: [
      {
        label: "Frontend",
        href: "https://github.com/genesis-morales/product-catalog-client",
      },
      {
        label: "Backend",
        href: "https://github.com/genesis-morales/product-catalog",
      },
    ],
  },
  {
    title: "Foro Hub API",
    category: "Backend · REST API",
    year: "2025",
    description:
      "API REST para gestión de foros con autenticación por token, control de acceso por roles y persistencia con PostgreSQL.",
    stack: ["Java", "Spring Boot", "Spring Security", "PostgreSQL", "JWT", "Bcrypt"],
    images: ["/projects/foro-hub.png"],
    alt: "Vista del proyecto Foro Hub",
    links: [
      {
        label: "Ver repositorio",
        href: "https://github.com/genesis-morales/foro-hub",
      },
    ],
  },

];
---
<section class="px-6 py-24 bg-surface-container-low" id="proyectos">
  <div class="mx-auto max-w-6xl">

  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-20">
      <h2 class="font-headline text-4xl md:text-5xl font-bold text-on-surface mb-4">Proyectos</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-primary to-transparent mx-auto"></div>
    </div>

    <div class="flex flex-col divide-y divide-outline-variant/15">
      {projects.map((project: Project, projectIndex: number) => (
        <article class="group py-12 md:py-16">
          <div class="flex flex-col gap-10 md:flex-row md:items-start md:gap-16">

            <div class="flex flex-1 flex-col gap-6">
              <div class="flex items-center gap-4">
                <span class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">
                  {project.category}
                </span>
                <span class="text-xs text-on-surface-variant/50">
                  {project.year}
                </span>
              </div>

              <h3 class="font-headline text-3xl font-bold text-on-surface md:text-4xl">
                {project.title}
              </h3>

              <p class="max-w-lg text-base leading-8 text-on-surface-variant">
                {project.description}
              </p>

              <div class="flex flex-wrap gap-2">
                {project.stack.map((tech: string) => (
                  <span class="rounded-full border border-outline-variant/20 bg-surface px-3 py-1 text-xs text-on-surface-variant">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="mt-2 flex flex-wrap gap-3">
                {project.links.map((link: ProjectLink) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-medium transition ${
                      link.primary
                        ? "bg-primary-container text-on-primary-container hover:opacity-90"
                        : "border border-outline-variant/20 bg-surface text-on-surface hover:bg-surface-container"
                    }`}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                      {link.primary ? (
                        <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                      ) : (
                        <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2.02c-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.04-.7.08-.69.08-.69 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.96.1-.74.4-1.25.72-1.54-2.56-.3-5.25-1.28-5.25-5.7 0-1.26.45-2.3 1.18-3.12-.12-.3-.51-1.5.11-3.12 0 0 .96-.3 3.15 1.19A10.9 10.9 0 0 1 12 6.32c.97 0 1.95.13 2.87.38 2.18-1.48 3.14-1.19 3.14-1.19.63 1.62.24 2.82.12 3.12.74.82 1.18 1.86 1.18 3.12 0 4.43-2.69 5.39-5.26 5.68.41.36.77 1.07.77 2.17v3.21c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
                      )}
                    </svg>
                    {link.label}
                  </a>
                ))}
              </div>
            </div>

            <div class="w-full md:w-[480px] shrink-0">
              <div class="overflow-hidden rounded-2xl border border-outline-variant/10 bg-surface-container">

                <button
                  type="button"
                  class="group/img relative block w-full aspect-[16/10] overflow-hidden"
                  data-lightbox-open={projectIndex}
                  aria-label={`Ver imagen de ${project.title} en grande`}
                >
                  {project.images.map((img: string, imgIndex: number) => (
                    <img
                      src={img}
                      alt={`${project.alt} ${imgIndex + 1}`}
                      class={`h-full w-full object-cover transition-all duration-300 group-hover/img:scale-[1.02] group-hover/img:brightness-90 ${
                        imgIndex === 0 ? "block" : "hidden"
                      }`}
                      data-project-image={projectIndex}
                      data-image-index={imgIndex}
                      loading="lazy"
                    />
                  ))}
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200 group-hover/img:opacity-100">
                    <span class="flex items-center gap-2 rounded-xl bg-black/60 px-4 py-2 text-sm font-medium text-white backdrop-blur-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                      </svg>
                      Ver en grande
                    </span>
                  </div>
                </button>

                {project.images.length > 1 && (
                  <div class="flex gap-2 overflow-x-auto border-t border-outline-variant/10 px-4 py-3">
                    {project.images.map((img: string, thumbIndex: number) => (
                      <button
                        type="button"
                        class={`shrink-0 overflow-hidden rounded-lg transition ${
                          thumbIndex === 0
                            ? "ring-2 ring-primary opacity-100"
                            : "opacity-50 hover:opacity-90"
                        }`}
                        data-thumb={projectIndex}
                        data-thumb-index={thumbIndex}
                        aria-label={`Ver captura ${thumbIndex + 1} de ${project.title}`}
                      >
                        <img
                          src={img}
                          alt=""
                          class="h-12 w-[72px] object-cover"
                          loading="lazy"
                        />
                      </button>
                    ))}
                  </div>
                )}

              </div>
            </div>

          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<!-- LIGHTBOX -->
<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Imagen en grande"
>
  <button
    type="button"
    id="lightbox-close"
    class="absolute right-5 top-5 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
    aria-label="Cerrar"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <button
    type="button"
    id="lightbox-prev"
    class="absolute left-4 top-1/2 -translate-y-1/2 flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
    aria-label="Imagen anterior"
  >
    ←
  </button>

  <button
    type="button"
    id="lightbox-next"
    class="absolute right-4 top-1/2 -translate-y-1/2 flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
    aria-label="Imagen siguiente"
  >
    →
  </button>

  <div class="flex max-h-[90vh] max-w-[92vw] items-center justify-center">
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[88vh] max-w-[88vw] rounded-2xl object-contain shadow-2xl"
    />
  </div>

  <div class="absolute bottom-5 left-1/2 -translate-x-1/2 text-sm text-white/60" id="lightbox-counter"></div>
</div>

<script>
  // --- Thumbnails ---
  document.querySelectorAll<HTMLElement>("[data-thumb]").forEach((thumb) => {
    thumb.addEventListener("click", () => {
      const projectIndex = thumb.getAttribute("data-thumb");
      const thumbIndex = thumb.getAttribute("data-thumb-index");
      if (projectIndex === null || thumbIndex === null) return;

      const activeIndex = Number(thumbIndex);

      document
        .querySelectorAll<HTMLElement>(`[data-project-image="${projectIndex}"]`)
        .forEach((img, i) => {
          img.classList.toggle("block", i === activeIndex);
          img.classList.toggle("hidden", i !== activeIndex);
        });

      document
        .querySelectorAll<HTMLElement>(`[data-thumb="${projectIndex}"]`)
        .forEach((btn, i) => {
          const isActive = i === activeIndex;
          btn.classList.toggle("ring-2", isActive);
          btn.classList.toggle("ring-primary", isActive);
          btn.classList.toggle("opacity-100", isActive);
          btn.classList.toggle("opacity-50", !isActive);
        });
    });
  });

  // --- Lightbox ---
  const lightbox = document.getElementById("lightbox") as HTMLElement;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const lightboxClose = document.getElementById("lightbox-close") as HTMLButtonElement;
  const lightboxPrev = document.getElementById("lightbox-prev") as HTMLButtonElement;
  const lightboxNext = document.getElementById("lightbox-next") as HTMLButtonElement;
  const lightboxCounter = document.getElementById("lightbox-counter") as HTMLElement;

  let currentImages: string[] = [];
  let currentLightboxIndex = 0;

  const openLightbox = (images: string[], startIndex: number): void => {
    currentImages = images;
    currentLightboxIndex = startIndex;
    updateLightboxImage();
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
  };

  const closeLightbox = (): void => {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
  };

  const updateLightboxImage = (): void => {
    lightboxImg.src = currentImages[currentLightboxIndex];
    lightboxImg.alt = `Imagen ${currentLightboxIndex + 1} de ${currentImages.length}`;
    lightboxCounter.textContent = `${currentLightboxIndex + 1} / ${currentImages.length}`;

    lightboxPrev.style.display = currentImages.length > 1 ? "flex" : "none";
    lightboxNext.style.display = currentImages.length > 1 ? "flex" : "none";
  };

  document
    .querySelectorAll<HTMLButtonElement>("[data-lightbox-open]")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const projectIndex = btn.getAttribute("data-lightbox-open");
        if (projectIndex === null) return;

        const visibleImg = btn.querySelector<HTMLElement>("[data-project-image].block");
        const startIndex = visibleImg
          ? Number(visibleImg.getAttribute("data-image-index"))
          : 0;

        const allImgs = btn.querySelectorAll<HTMLImageElement>("[data-project-image]");
        const srcs: string[] = Array.from(allImgs).map((img) => img.src);

        openLightbox(srcs, startIndex);
      });
    });

  lightboxClose.addEventListener("click", closeLightbox);

  lightbox.addEventListener("click", (e: MouseEvent) => {
    if (e.target === lightbox) closeLightbox();
  });

  lightboxPrev.addEventListener("click", () => {
    currentLightboxIndex =
      currentLightboxIndex === 0
        ? currentImages.length - 1
        : currentLightboxIndex - 1;
    updateLightboxImage();
  });

  lightboxNext.addEventListener("click", () => {
    currentLightboxIndex =
      currentLightboxIndex === currentImages.length - 1
        ? 0
        : currentLightboxIndex + 1;
    updateLightboxImage();
  });

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (lightbox.classList.contains("hidden")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") lightboxPrev.click();
    if (e.key === "ArrowRight") lightboxNext.click();
  });
</script>