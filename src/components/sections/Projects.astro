---
const projects = [
  {
    title: "Task Manager",
    description: "Gestión de tareas con autenticación y organización por estados.",
    stack: "React · TypeScript · Vite · SCSS",
    tag: "Proyecto personal",
    tagColor: "text-primary bg-primary/20",
    image: "/projects/task-manager.png",
    alt: "Task Manager",
    cols: "md:col-span-7",
    aspect: "aspect-[16/10]",
  },
  {
    title: "Foro Hub",
    description: "API REST para foros con Spring Security y PostgreSQL.",
    stack: "Java · Spring Boot · PostgreSQL",
    tag: "Proyecto académico",
    tagColor: "text-secondary bg-secondary/20",
    image: "/projects/foro-hub.png",
    alt: "Foro Hub",
    cols: "md:col-span-5",
    aspect: "min-h-[400px]",
  },
  {
    title: "Catálogo E-commerce",
    description: "Sistema completo de gestión de productos con categorías, subcategorías y carga de imágenes.",
    stack: "Laravel · React · TypeScript · MySQL",
    tag: "Proyecto personal",
    tagColor: "text-primary bg-primary/20",
    image: "/projects/ecommerce.png",
    alt: "Catálogo E-commerce",
    cols: "md:col-span-12",
    aspect: "aspect-[21/9]",
  },
]
---
<section class="py-32 px-6 bg-surface-container-low" id="proyectos">
  <div class="max-w-7xl mx-auto">
    <div class="mb-16">
      <h2 class="font-headline text-4xl md:text-5xl font-bold text-on-surface mb-4">Proyectos</h2>
      <p class="text-on-surface-variant text-lg">Trabajo académico y personal</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      {projects.map((p) => (
        <div class={`${p.cols} group cursor-pointer`}>
          <div class={`relative rounded-2xl overflow-hidden bg-surface-container-high ${p.aspect} border border-outline-variant/10`}>
            <img
              src={p.image}
              alt={p.alt}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-dim via-transparent to-transparent opacity-70"></div>
            <div class="absolute bottom-6 left-6 right-6">
              <span class={`${p.tagColor} backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold uppercase mb-3 inline-block`}>
                {p.tag}
              </span>
              <h3 class="text-2xl font-bold text-white mb-2">{p.title}</h3>
              <p class="text-slate-200 text-sm">{p.description}</p>
              <p class="text-slate-400 text-xs mt-1">{p.stack}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>